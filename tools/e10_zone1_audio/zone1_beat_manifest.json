      "output_filename": "e10_z1_shot01_beat01_zh-TW.mp3"
    },
    {
      "shot": 2,
      "beat": 1,
      "phase": "PRE_PLAY",
      "speaker": "elder",
      "locale": "en",
      "text": "Morning, child.",
