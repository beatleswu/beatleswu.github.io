[Unit]
Description=Godokro weekly OCI snapshot
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
Environment=CLOUDSDK_CONFIG=/home/ubuntu/.config/gcloud
EnvironmentFile=-/etc/godokro-backup.env
WorkingDirectory=/opt/go-odyssey
ExecStart=/opt/go-odyssey/ops/backup/linux/backup.sh weekly

[Install]
WantedBy=multi-user.target
