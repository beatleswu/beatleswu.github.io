    "external_content_boundary": {
      "description": "Deliberately excluded from the application image as of DEPLOY-GOV-2E. The image builds and starts successfully without any of these being present; app.py already degrades gracefully (404 per missing static file, empty puzzle list) rather than crashing.",
      "entries": [
        {
          "path": "assets/",
          "size": "757MB",
          "treatment": "VERSIONED STATIC ARTIFACT, mounted read-only at runtime",
          "mount_contract": "GO_ODYSSEY_LIVE_STATIC_ROOT env var (docker-compose.prod.yml), read via app.py's _serve_live_static_or_baked_subpath for the /assets/<path:subpath> route",
          "absent_behavior": "individual asset files return 404; app process stays healthy"
        },
        {
          "path": "shorts/",
          "size": "113MB",
          "treatment": "VERSIONED STATIC ARTIFACT (optional marketing media), mounted read-only at runtime",
          "mount_contract": "same GO_ODYSSEY_LIVE_STATIC_ROOT mechanism as assets/, via the /shorts/<filename> route",
          "absent_behavior": "individual short files return 404; app process stays healthy"
        },
        {
          "path": "questions.json",
          "size": "58MB, 41591 records",
          "treatment": "VERSIONED CONTENT BASELINE + persistent runtime storage (admin-mutable via the question-management API)",
          "mount_contract": "QUESTIONS_JSON_PATH env var (docker-compose.prod.yml), defaults to /app/data/questions.json inside the persistent go-data volume so admin edits survive container recreation",
          "absent_behavior": "app.py's _load_questions()/_load_questions_fresh() already guard with os.path.exists() and return an empty list; puzzle-serving routes degrade, app process stays healthy"
        }
      ]
    },
    "excluded_permanently": {
      "description": "Removed from the Dockerfile and build manifest in DEPLOY-GOV-2E. Not a content-boundary/mount question -- these should never enter a production image at all.",
      "entries": [
        {
          "path": "srs.db",
          "reason": "USER DATA -- table inventory includes users, friendships, game_results, teacher_student, teacher_comments, share_links, and player_* progress/inventory tables. Not referenced by any sqlite3.connect() call in current app.py/scheduler.py/shadow_judging.py/grimoire_api.py/db.py -- PostgreSQL is the authoritative runtime database. Must never be committed to Git or baked into an image."
        },
        {
          "path": "go_learning.db",
          "reason": "OBSOLETE -- confirmed unreferenced by current runtime code; its two tables (zones, grimoires) are already created directly in PostgreSQL by app.py (CREATE TABLE IF NOT EXISTS zones/grimoires)."
        },
        {
          "path": "docs/testing/",
          "reason": "INTERNAL QA evidence (rwd_batch* reports, tree_null_records, parse_fail_repair_report). Zero references anywhere in app.py/scheduler.py/shadow_judging.py. Never had a runtime purpose in a production image."
        }
      ]
    },
    "runtime_only_not_build_inputs": [
      {
        "path": "katago_cache.db",
        "reason": "mounted as a read-only bind volume in docker-compose.prod.yml; never COPYed into the image by the Dockerfile"
      },
      {
        "path": "/opt/go-odyssey-static",
        "reason": "external content mount serving assets/ and shorts/, see external_content_boundary above"
      }
    ]
  },
