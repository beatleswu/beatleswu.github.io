{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godokoro.com/schemas/workflow-v2-pr-evidence.schema.json",
  "title": "Go Odyssey Workflow V2 PR evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "repository",
    "generated_at",
    "base_ref",
    "base_sha",
    "pr_head",
    "risk_class",
    "classification_basis",
    "scope",
    "relevance",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow-v2-evidence-v1"
    },
    "artifact_kind": {
      "const": "PR_EVIDENCE"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "$ref": "#/$defs/sha40"
    },
    "pr_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "pr_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha",
        "tree_sha",
        "parents"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "$ref": "#/$defs/sha40"
        },
        "tree_sha": {
          "$ref": "#/$defs/sha40"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha40"
          }
        }
      }
    },
    "risk_class": {
      "enum": [
        "NORMAL",
        "HOTFIX",
        "HEAVY"
      ]
    },
    "classification_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "planned_release_type": {
      "enum": [
        "APP_ONLY",
        "STATIC_ONLY",
        "PAIRED_APP_STATIC"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "changed_files"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "status",
              "blob_sha"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "previous_path": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "A",
                  "C",
                  "D",
                  "M",
                  "R",
                  "T",
                  "U"
                ]
              },
              "blob_sha": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_relevant",
        "javascript_relevant",
        "browser_relevant"
      ],
      "properties": {
        "python_relevant": {
          "type": "boolean"
        },
        "javascript_relevant": {
          "type": "boolean"
        },
        "browser_relevant": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "checks"
      ],
      "properties": {
        "result": {
          "const": "PASS"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "category",
              "status"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_APPLICABLE"
                ]
              },
              "details": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
