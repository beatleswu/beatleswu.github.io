{
  "SCHEMA_VERSION": "E10_ZONE3_CINEMATIC_SUBTITLES_V1",
  "ZONE": 3,
  "ZONE_NAME_ZH_TW": "哥布林洞穴",
  "CANONICAL_SCRIPT_SOURCE": "COORDINATOR_ISSUED_OWNER_APPROVED_ZONE3_CHILD_READABLE_PAYLOAD",
  "LOCALE": "zh-TW",
  "APPLICATION_LOCALE": "zh",
  "LOCALE_ALIASES": { "zh": "zh-TW" },
  "SHOT_PHASES": {
    "FIRST_ENTRY": ["SHOT01", "SHOT02", "SHOT03", "SHOT04", "SHOT05"],
    "BOSS_READY": ["SHOT06", "SHOT07"],
    "POST_CLEAR": ["SHOT08", "SHOT09", "SHOT10"]
  },
  "TEXT_AUTHORITY": "This manifest is the single localized dialogue source. Audio generation consumes VISIBLE_TEXT; audio manifests store TEXT_HASH only.",
  "beats": [
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "奇怪……大家怎麼都背著行李？" },
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B002", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "連老人和小孩都在走，這不像要打仗……" },
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "他們好像是在搬家。" },
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "可是……為什麼整個村子都要搬走呢？" },

    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "這些不是武器……" },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B002", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "水壺、毯子、鍋子……都是平常生活用的東西。" },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "連小孩子最喜歡的玩具也帶走了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "他們是真的非走不可。" },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "而且……可能連自己還能不能回來都不知道。" },

    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B001", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "別再靠近了！" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我們今天已經搬了三次家……" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "大家又累又餓，我沒有力氣再跟你打架。" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot03.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我不是來打架的。" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot03.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你們為什麼一直往洞穴更深的地方搬？" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我們不是在躲你。" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我們是在躲這個地方。" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot03.beat08", "LOCALE": "zh-TW", "VISIBLE_TEXT": "躲……自己的家？" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B009", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat09", "LOCALE": "zh-TW", "VISIBLE_TEXT": "每個帶著武器走進來的人，都說自己不會傷害我們。" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B010", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat10", "LOCALE": "zh-TW", "VISIBLE_TEXT": "跟我來吧。" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B011", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat11", "LOCALE": "zh-TW", "VISIBLE_TEXT": "等你看見那些地方，就會明白我們為什麼一直往裡面退。" },

    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B001", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "去年，我們還住在最外面那一區。" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "後來那裡不能住了，我們只好往裡搬。" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "上個月，我們還住在這裡。" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "現在連這裡也快待不下去了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B005", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "睡覺的地方不見了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "放食物的地方也越來越少。" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "連去取水的路，都快沒有了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot04.beat08", "LOCALE": "zh-TW", "VISIBLE_TEXT": "所以你們不是一直在往外搶地盤……" },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B009", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot04.beat09", "LOCALE": "zh-TW", "VISIBLE_TEXT": "是你們原本能走的路，一條一條消失了。" },

    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "水明明就在那邊！" },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot05.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "昨天這條路還走得過去。" },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot05.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "今天早上，石頭就全掉下來了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot05.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "孩子拿著水桶來，也只能站在這裡看。" },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "所以不是你們自己想一直往裡面搬……" },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B006", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "是這座洞穴一直把你們往裡面擠。" },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B007", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "再這樣下去，你們就真的沒有地方可以退了。" },

    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot06.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你就是這裡的首領嗎？" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B002", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "不是。" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B003", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我是最後一道門。" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B004", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "老人、孩子，還有不能戰鬥的人，都在我的後面。" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot06.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "可是你一直守住這條路，他們也會被困在裡面。" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B006", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你看見我站在這裡，就以為我要的是土地。" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B007", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "可如果我退開一步，我的族人又能往哪裡去？" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B008", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat08", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我要的是土地，還是讓我的族人活下來？" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B009", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat09", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你真的分得開嗎？" },

    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B001", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "Grik 願意相信你。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B002", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "但我不能只因為他的話，就把所有人的命交到你手上。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "那我要怎麼做？" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B004", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "證明你看到的不只是你自己的路。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你的族人需要活下去。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B006", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "可是其他人，也不能永遠失去通過這裡的路。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B007", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "那就讓我試試。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat08", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我不是來搶你們的地。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B009", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat09", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我想找的是一條，不需要再把任何人趕走的路。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B010", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat10", "LOCALE": "zh-TW", "VISIBLE_TEXT": "好。" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B011", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat11", "LOCALE": "zh-TW", "VISIBLE_TEXT": "那就讓我看看——" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B012", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat12", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你到底能不能看清楚整個局面！" },

    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B001", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你贏了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B002", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "如果你現在要把我們趕走，我已經沒有理由攔你。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我不會這麼做。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我贏，不是為了讓你們再搬一次家。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B005", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "別把這叫做和解。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B006", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我還沒有完全相信你。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B007", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "今天……我只是願意讓你從這裡走過去。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B008", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot08.beat08", "LOCALE": "zh-TW", "VISIBLE_TEXT": "至少今晚……孩子們不用再搬家了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B009", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat09", "LOCALE": "zh-TW", "VISIBLE_TEXT": "今晚而已。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B010", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat10", "LOCALE": "zh-TW", "VISIBLE_TEXT": "今晚也很好。" },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B011", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat11", "LOCALE": "zh-TW", "VISIBLE_TEXT": "至於明天的路，我們可以一起找。" },

    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B001", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "這個給你。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B002", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "這是什麼？" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "一小塊石頭。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "每次牆又往前逼一點，我們就在上面留下一個記號。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B005", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "不管搬到哪裡，我都一直帶著它。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "因為我不想忘記，我們以前住過哪裡。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "也不想忘記，哪些路已經消失了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat08", "LOCALE": "zh-TW", "VISIBLE_TEXT": "所以這可能是線索。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B009", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat09", "LOCALE": "zh-TW", "VISIBLE_TEXT": "你可以去查。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B010", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat10", "LOCALE": "zh-TW", "VISIBLE_TEXT": "但別把它當答案。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B011", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat11", "LOCALE": "zh-TW", "VISIBLE_TEXT": "它只能告訴你——哪裡曾經有一條路。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B012", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat12", "LOCALE": "zh-TW", "VISIBLE_TEXT": "真正發生了什麼，還是要你自己去看。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B013", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat13", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我會帶著它。" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B014", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat14", "LOCALE": "zh-TW", "VISIBLE_TEXT": "但我不會把你們的家當成我要拿走的東西。" },

    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat01", "LOCALE": "zh-TW", "VISIBLE_TEXT": "這塊石頭最早是在哪裡留下記號的？" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat02", "LOCALE": "zh-TW", "VISIBLE_TEXT": "森林那邊。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat03", "LOCALE": "zh-TW", "VISIBLE_TEXT": "以前霧還沒有這麼厚的時候，我們常常走那條路。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat04", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我們會跟森林那邊的人交換水、種子和食物。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B005", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat05", "LOCALE": "zh-TW", "VISIBLE_TEXT": "可是後來霧越來越厚。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat06", "LOCALE": "zh-TW", "VISIBLE_TEXT": "路一條一條不見了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat07", "LOCALE": "zh-TW", "VISIBLE_TEXT": "最近，也已經很久沒有人從森林那邊過來。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat08", "LOCALE": "zh-TW", "VISIBLE_TEXT": "哥布林洞穴的路消失了。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B009", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat09", "LOCALE": "zh-TW", "VISIBLE_TEXT": "迷霧森林的路也消失了……" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B010", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat10", "LOCALE": "zh-TW", "VISIBLE_TEXT": "這一定不是巧合。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B011", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat11", "LOCALE": "zh-TW", "VISIBLE_TEXT": "走吧！" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B012", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat12", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我們去迷霧森林看看。" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B013", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat13", "LOCALE": "zh-TW", "VISIBLE_TEXT": "我會記住來時的路！" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B014", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat14", "LOCALE": "zh-TW", "VISIBLE_TEXT": "別只記得路——" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B015", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat15", "LOCALE": "zh-TW", "VISIBLE_TEXT": "也要記得路上住著誰。" }
  ]
}
