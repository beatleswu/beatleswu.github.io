{
  "SCHEMA_VERSION": "E10_ZONE3_CINEMATIC_SUBTITLES_V1",
  "ZONE": 3,
  "ZONE_NAME_ZH_TW": "哥布林洞穴",
  "ZONE_NAME_EN_US": "Goblin Cave",
  "CANONICAL_SCRIPT_SOURCE": "assets/e10/i18n/zone3/zone3-cinematic-subtitles.json",
  "SOURCE_LOCALE": "zh-TW",
  "LOCALE": "en-US",
  "APPLICATION_LOCALE": "en",
  "LOCALE_ALIASES": { "en": "en-US", "en-US": "en-US" },
  "SHOT_PHASES": {
    "FIRST_ENTRY": ["SHOT01", "SHOT02", "SHOT03", "SHOT04", "SHOT05"],
    "BOSS_READY": ["SHOT06", "SHOT07"],
    "POST_CLEAR": ["SHOT08", "SHOT09", "SHOT10"]
  },
  "TEXT_AUTHORITY": "This manifest is the en-US visible dialogue source for the exact 97-beat Zone 3 script. It does not bind or imply English voice approval.",
  "VOICE_POLICY": "SUBTITLE_ONLY_UNTIL_OWNER_APPROVED_EN_US_VOICE",
  "CROSS_LANGUAGE_VOICE_FALLBACK": "FORBIDDEN",
  "beats": [
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat01", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Strange... why is everyone carrying their things?" },
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B002", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat02", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Even the old people and children are leaving. This doesn't look like a battle..." },
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat03", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "It looks like they're moving away." },
    { "ZONE": 3, "SHOT_ID": "SHOT01", "BEAT_ID": "Z3_S01_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot01.beat04", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "But... why does the whole village have to leave?" },

    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat01", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "These aren't weapons..." },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B002", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat02", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Water jars, blankets, pots... things they use every day." },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat03", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "They even brought the children's favorite toys." },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat04", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "They really have no choice but to leave." },
    { "ZONE": 3, "SHOT_ID": "SHOT02", "BEAT_ID": "Z3_S02_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot02.beat05", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "And... they may not even know if they can come back." },

    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B001", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat01", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Don't come any closer!" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat02", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "We've moved three times today..." },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat03", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Everyone is tired and hungry. I don't have the strength to fight you." },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot03.beat04", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "I'm not here to fight." },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot03.beat05", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Why do you keep moving deeper into the cave?" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat06", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "We're not hiding from you." },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat07", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "We're hiding from this place." },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot03.beat08", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Hiding from... your own home?" },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B009", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat09", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Everyone who comes in carrying a weapon says they won't hurt us." },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B010", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat10", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Come with me." },
    { "ZONE": 3, "SHOT_ID": "SHOT03", "BEAT_ID": "Z3_S03_B011", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot03.beat11", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "When you see those places, you'll understand why we keep retreating deeper inside." },

    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B001", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat01", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Last year, we still lived in the outermost part." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat02", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Then it became unsafe, so we had to move farther in." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat03", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Last month, we still lived here." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat04", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Now we can hardly stay here, either." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B005", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat05", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "The place where we slept is gone." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat06", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "There is less and less room to keep our food, too." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot04.beat07", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "Even the path to get water is almost gone." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot04.beat08", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "So you weren't pushing outward to take more land..." },
    { "ZONE": 3, "SHOT_ID": "SHOT04", "BEAT_ID": "Z3_S04_B009", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot04.beat09", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "The paths you used to take were disappearing, one by one." },

    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat01", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "But the water is right there!" },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot05.beat02", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "We could still walk this way yesterday." },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot05.beat03", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "This morning, all the rocks came down." },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot05.beat04", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "The children came with their buckets, but they could only stand here and look." },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat05", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "So you didn't choose to keep moving inward..." },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B006", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat06", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "The cave kept squeezing you farther and farther in." },
    { "ZONE": 3, "SHOT_ID": "SHOT05", "BEAT_ID": "Z3_S05_B007", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot05.beat07", "LOCALE": "en-US", "LIFECYCLE": "FIRST_ENTRY", "VISIBLE_TEXT": "If this keeps going, you really won't have anywhere left to retreat." },

    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot06.beat01", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Are you the leader here?" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B002", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat02", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "No." },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B003", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat03", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "I am the last gate." },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B004", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat04", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "The elders, the children, and those who cannot fight are all behind me." },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot06.beat05", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "But if you keep this path closed, they'll be trapped inside." },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B006", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat06", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "You see me standing here and think I want land." },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B007", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat07", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "But if I step aside, where can my people go?" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B008", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat08", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Do I want land, or do I want my people to live?" },
    { "ZONE": 3, "SHOT_ID": "SHOT06", "BEAT_ID": "Z3_S06_B009", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot06.beat09", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Can you really tell the difference?" },

    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B001", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat01", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Grik is willing to trust you." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B002", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat02", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "But I cannot put everyone's life in your hands just because he says so." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat03", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Then what should I do?" },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B004", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat04", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Prove that you see more than your own path." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B005", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat05", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Your people need to survive." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B006", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat06", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "But other people cannot lose the path through here forever." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B007", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat07", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Then let me try." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat08", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "I'm not here to take your land." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B009", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot07.beat09", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "I'm looking for a path that won't force anyone else to leave." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B010", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat10", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "All right." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B011", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat11", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "Then let me see..." },
    { "ZONE": 3, "SHOT_ID": "SHOT07", "BEAT_ID": "Z3_S07_B012", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot07.beat12", "LOCALE": "en-US", "LIFECYCLE": "BOSS_READY", "VISIBLE_TEXT": "whether you can really see the whole picture!" },

    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B001", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat01", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "You won." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B002", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat02", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "If you want to drive us away now, I have no reason left to stop you." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B003", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat03", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "I won't do that." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B004", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat04", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "I didn't win so you would have to move again." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B005", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat05", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Don't call this a truce." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B006", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat06", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "I still don't fully trust you." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B007", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat07", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Today... I am only willing to let you pass through here." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B008", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot08.beat08", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "At least tonight... the children won't have to move again." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B009", "CHARACTER": "CENTURION", "I18N_KEY": "e9.zone3.cinematic.shot08.beat09", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Only tonight." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B010", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat10", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Tonight is good enough." },
    { "ZONE": 3, "SHOT_ID": "SHOT08", "BEAT_ID": "Z3_S08_B011", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot08.beat11", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "As for tomorrow's path, we can find it together." },

    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B001", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat01", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Here. Take this." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B002", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat02", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "What is it?" },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat03", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "A little piece of stone." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat04", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Whenever the wall pushes forward again, we leave a mark on it." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B005", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat05", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "No matter where we move, I keep carrying it." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat06", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Because I don't want to forget where we used to live." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat07", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "And I don't want to forget which paths have disappeared." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat08", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "So this might be a clue." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B009", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat09", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "You can look into it." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B010", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat10", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "But don't treat it as the answer." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B011", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat11", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "It can only tell you where a path once was." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B012", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot09.beat12", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "To learn what really happened, you still have to see it for yourself." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B013", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat13", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "I'll carry it." },
    { "ZONE": 3, "SHOT_ID": "SHOT09", "BEAT_ID": "Z3_S09_B014", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot09.beat14", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "But I won't treat your homes as things I can take." },

    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B001", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat01", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Where did this stone first leave a mark?" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B002", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat02", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Over by the forest." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B003", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat03", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Back when the mist wasn't so thick, we often took that path." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B004", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat04", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "We traded water, seeds, and food with the people from the forest." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B005", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat05", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "But later, the mist grew thicker and thicker." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B006", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat06", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "The paths disappeared, one by one." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B007", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat07", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Lately, no one has come from the forest for a long time." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B008", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat08", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "The path through Goblin Cave is gone." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B009", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat09", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "And the path through Misty Forest is gone, too..." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B010", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat10", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "That can't be a coincidence." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B011", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat11", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Let's go!" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B012", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat12", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Let's go see what is happening in Misty Forest." },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B013", "CHARACTER": "HERO", "I18N_KEY": "e9.zone3.cinematic.shot10.beat13", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "I'll remember the path we came by!" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B014", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat14", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Don't just remember the path\u2014" },
    { "ZONE": 3, "SHOT_ID": "SHOT10", "BEAT_ID": "Z3_S10_B015", "CHARACTER": "GRIK", "I18N_KEY": "e9.zone3.cinematic.shot10.beat15", "LOCALE": "en-US", "LIFECYCLE": "POST_CLEAR", "VISIBLE_TEXT": "Remember who lives along it, too." }
  ]
}
