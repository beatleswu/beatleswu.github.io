{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godokoro.com/schemas/content_release_registry.schema.json",
  "title": "Go Odyssey Content Release Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "created_at_utc",
    "record_count",
    "uncompressed_byte_count",
    "uncompressed_sha256",
    "compressed_filename",
    "compressed_sha256",
    "baseline_sha256",
    "release_candidate_sha256",
    "release_manifest_filename",
    "release_manifest_sha256",
    "rollback_manifest_filename",
    "rollback_manifest_sha256",
    "acceptance_evidence_filename",
    "acceptance_evidence_sha256",
    "source_provenance",
    "review_binding_sha256",
    "repair_batch_manifest_sha256",
    "mutation_audit_sha256",
    "allowed_asset_names",
    "changed_record_count",
    "review_group_count",
    "excluded_record_count",
    "release_records",
    "excluded_map_battle_records"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "artifact_role": {"const": "content_release_candidate"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "record_count": {"type": "integer", "minimum": 0},
    "uncompressed_byte_count": {"type": "integer", "minimum": 1},
    "uncompressed_sha256": {"$ref": "#/$defs/sha256"},
    "compressed_filename": {"type": "string", "pattern": "^[^/\\\\]+\\.gz$"},
    "compressed_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "release_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "release_manifest_filename": {"type": "string", "minLength": 1},
    "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "rollback_manifest_filename": {"type": "string", "minLength": 1},
    "rollback_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_evidence_filename": {"type": "string", "minLength": 1},
    "acceptance_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "source_provenance": {"$ref": "#/$defs/sourceProvenance"},
    "review_binding_sha256": {"$ref": "#/$defs/sha256"},
    "repair_batch_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "mutation_audit_sha256": {"$ref": "#/$defs/sha256"},
    "allowed_asset_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "changed_record_count": {"type": "integer", "minimum": 0},
    "review_group_count": {"type": "integer", "minimum": 0},
    "excluded_record_count": {"type": "integer", "minimum": 0},
    "release_records": {"type": "integer", "minimum": 0},
    "excluded_map_battle_records": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_repo_id",
        "source_commit_or_snapshot_id",
        "source_path",
        "source_sha256",
        "source_size_bytes",
        "source_record_count",
        "source_status",
        "source_identity_sha256"
      ],
      "properties": {
        "source_kind": {"enum": ["local_file", "git_blob", "immutable_snapshot"]},
        "source_repo_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "source_commit_or_snapshot_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_size_bytes": {"type": "integer", "minimum": 1},
        "source_record_count": {"type": "integer", "minimum": 0},
        "source_status": {"type": "string", "minLength": 1},
        "source_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "review_source_id": {"$ref": "#/$defs/sha256"},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "detector_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "validation_pack_id": {"$ref": "#/$defs/sha256"},
        "approved_proposal_set_sha256": {"$ref": "#/$defs/sha256"},
        "repair_batch_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
